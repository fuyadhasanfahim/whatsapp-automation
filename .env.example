# --- Postgres (docker-compose) ---
POSTGRES_USER=devhr
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_DB=devhr
POSTGRES_PORT=5432
DATABASE_URL="postgresql://devhr:change-me-to-a-long-random-value@localhost:5432/devhr?schema=public"

# --- Redis (docker-compose) ---
REDIS_PASSWORD=change-me-to-a-long-random-value
REDIS_PORT=6380
REDIS_HOST=localhost

# --- App ---
NODE_ENV=development
PORT=3000
JWT_SECRET=change-me-to-a-long-random-value
JWT_EXPIRES_IN=1d

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_VERIFY_TOKEN=change-me-to-a-long-random-value
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Single support number that gets the "please reply" escalation ping for the MVP
WHATSAPP_SUPPORT_NUMBER=

# --- Meeting scheduling (shared with dev-hr-management) ---
# Same MongoDB the dev-hr-management server's Meeting collection lives in, so a bot-proposed
# meeting shows up in that dashboard and gets its existing reminder emails/SMS.
MEETING_MONGO_URI=
# ObjectId of the dev-hr-management "user" document to record as the meeting's creator.
MEETING_CREATED_BY_USER_ID=
# Same Google Calendar service-account credentials dev-hr-management uses, so Webi can create
# real Google Meet links directly (see dev-hr-management/server/.env for the source values).
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
