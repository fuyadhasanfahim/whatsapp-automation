# --- Postgres (docker-compose) ---
POSTGRES_USER=devhr
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_DB=devhr
POSTGRES_PORT=5432
DATABASE_URL="postgresql://devhr:change-me-to-a-long-random-value@localhost:5432/devhr?schema=public"

# --- Redis (docker-compose) ---
REDIS_PASSWORD=change-me-to-a-long-random-value
REDIS_PORT=6380
REDIS_HOST=localhost

# --- App ---
NODE_ENV=development
PORT=3000
JWT_SECRET=change-me-to-a-long-random-value
JWT_EXPIRES_IN=1d

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_VERIFY_TOKEN=change-me-to-a-long-random-value
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Single support number that gets the "please reply" escalation ping for the MVP
WHATSAPP_SUPPORT_NUMBER=
